{
  "name": "reviewer",
  "version": "0.1.8",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm version patch --no-git-tag-version",
    "build": "ng build && shx cp config/config.prod.json dist/reviewer/browser/config.json",
    "copy-config": "shx cp config/config.prod.json dist/reviewer/browser/config.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.15",
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.13",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.1.0",
    "firebase": "^12.14.0",
    "github-markdown-css": "^5.9.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "ngx-markdown": "^21.3.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@types/google.accounts": "^0.0.18",
    "@types/prismjs": "^1.26.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
